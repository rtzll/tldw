#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  tunnel-launchd install <label> <keychain-service> <tunnel-client> <profile> <repo-dir> <mcp-command> <mcp-host> <mcp-port>
  tunnel-launchd uninstall <label>
  tunnel-launchd restart <label>
  tunnel-launchd status <label> [--raw]
  tunnel-launchd logs [--tail]
  tunnel-launchd run <keychain-service> <tunnel-client> <profile> <mcp-command> <mcp-host> <mcp-port>
EOF
  exit 64
}

xml_escape() {
  local value="$1"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  printf '%s' "$value"
}

user_domain() {
  printf 'gui/%s' "$(/usr/bin/id -u)"
}

keychain_account() {
  /usr/bin/id -un
}

install_agent() {
  [[ $# -eq 8 ]] || usage

  local label="$1"
  local keychain_service="$2"
  local tunnel_client="$3"
  local profile="$4"
  local repo_dir="$5"
  local mcp_command="$6"
  local mcp_host="$7"
  local mcp_port="$8"
  local client

  case "$tunnel_client" in
    /*) client="$tunnel_client" ;;
    */*) client="$repo_dir/$tunnel_client" ;;
    *) client="$(command -v "$tunnel_client" || true)" ;;
  esac

  test -n "$client" && test -x "$client" || {
    echo "Install tunnel-client with 'brew install openai/tools/tunnel-client' or set TLDW_TUNNEL_CLIENT"
    exit 1
  }

  local account
  account="$(keychain_account)"
  if [[ -n "${CONTROL_PLANE_API_KEY:-}" ]]; then
    /usr/bin/security add-generic-password \
      -a "$account" \
      -s "$keychain_service" \
      -w "$CONTROL_PLANE_API_KEY" \
      -T /usr/bin/security \
      -U >/dev/null
    echo "Stored CONTROL_PLANE_API_KEY in Keychain service $keychain_service"
  elif ! /usr/bin/security find-generic-password -a "$account" -s "$keychain_service" -w >/dev/null 2>&1; then
    echo "Set CONTROL_PLANE_API_KEY=sk-... once before running this recipe"
    exit 1
  fi

  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local log_dir="$HOME/Library/Logs/tldw"
  local script="$repo_dir/scripts/tunnel-launchd"
  mkdir -p "$(dirname "$plist")" "$log_dir"

  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(xml_escape "$script")</string>
    <string>run</string>
    <string>$(xml_escape "$keychain_service")</string>
    <string>$(xml_escape "$client")</string>
    <string>$(xml_escape "$profile")</string>
    <string>$(xml_escape "$mcp_command")</string>
    <string>$(xml_escape "$mcp_host")</string>
    <string>$(xml_escape "$mcp_port")</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$(xml_escape "$repo_dir")</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$log_dir/tunnel.out.log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$log_dir/tunnel.err.log")</string>
</dict>
</plist>
EOF

  /usr/bin/plutil -lint "$plist" >/dev/null
  /bin/launchctl bootout "$(user_domain)" "$plist" >/dev/null 2>&1 || true
  /bin/launchctl bootstrap "$(user_domain)" "$plist"
  /bin/launchctl enable "$(user_domain)/$label"
  /bin/launchctl kickstart -k "$(user_domain)/$label"

  echo "Installed and started $label"
  echo "Logs: $log_dir/tunnel.out.log and $log_dir/tunnel.err.log"
}

uninstall_agent() {
  [[ $# -eq 1 ]] || usage

  local label="$1"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  /bin/launchctl bootout "$(user_domain)" "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
  echo "Removed $label"
}

restart_agent() {
  [[ $# -eq 1 ]] || usage

  local label="$1"
  /bin/launchctl kickstart -k "$(user_domain)/$label"
  echo "Restarted $label"
}

summarize_agent_status() {
  # Only read top-level fields: nested launchd diagnostics also contain state.
  awk '
    depth == 1 {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      separator = index(line, " = ")
      if (separator) {
        key = substr(line, 1, separator - 1)
        value = substr(line, separator + 3)
        fields[key] = value
      }
    }
    /\{$/ { depth++ }
    /^[[:space:]]*\}$/ { depth-- }
    END {
      state = fields["state"]
      if (state == "running") {
        printf "Service:       Running"
        if (fields["pid"] != "") printf " (PID %s)", fields["pid"]
        print ""
      } else {
        printf "Service:       Not running (launchd state: %s)\n", (state != "" ? state : "unknown")
      }
      if (fields["runs"] != "")
        printf "Launches:      %s since the service was loaded\n", fields["runs"]
      signal = fields["last terminating signal"]
      code = fields["last exit code"]
      if (signal != "") {
        if (signal == "Killed: 9" || signal == "9" || signal == "SIGKILL") {
          print "Previous stop: Forced stop (SIGKILL). A forced restart can cause this."
        } else {
          printf "Previous stop: Signal %s\n", signal
        }
      } else if (code != "") {
        if (code == "0") print "Previous exit: Successful (code 0)"
        else printf "Previous exit: Error (code %s); check the logs for the cause.\n", code
      }
      if (state != "running")
        print "Next step:     Check the logs, then run just tunnel-launchd-restart."
    }
  '
}

status_agent() {
  [[ $# -ge 1 && $# -le 2 ]] || usage
  local label="$1"
  local mode="${2:-}"
  [[ -z "$mode" || "$mode" == "--raw" ]] || usage
  local target="$(user_domain)/$label"
  if [[ "$mode" == "--raw" ]]; then
    /bin/launchctl print "$target"
    return
  fi

  local report
  if ! report="$(/bin/launchctl print "$target" 2>&1)"; then
    if [[ "$report" == *"Could not find service"* ]]; then
      if [[ -f "$HOME/Library/LaunchAgents/$label.plist" ]]; then
        printf 'Service:       Not loaded\n'
      else
        printf 'Service:       Not installed\n'
      fi
      printf 'Next step:     Run just tunnel-launchd-install.\n'
    else
      printf 'Unable to read launchd status for %s:\n%s\n' "$label" "$report" >&2
    fi
    return 1
  fi

  printf 'tldw background service (%s)\n\n' "$label"
  printf '%s\n' "$report" | summarize_agent_status

  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local service_path binary version
  service_path="$(/usr/bin/plutil -extract EnvironmentVariables.PATH raw -o - "$plist" 2>/dev/null)" || service_path=""
  if [[ -n "$service_path" ]]; then
    binary="$(PATH="$service_path" command -v tldw)" || binary=""
    if [[ -n "$binary" ]] && version="$("$binary" version 2>/dev/null)"; then
      printf 'Installed CLI: %s\n' "${version%% (*}"
      printf '               Restart after upgrading; the running version is not checked here.\n'
    fi
  fi
  printf '\nThis reports the launchd process; tunnel connectivity is not checked.\n'
  printf 'Logs:          just tunnel-launchd-logs\n'
  printf 'Full details:  just tunnel-launchd-status --raw\n'
}

run_agent() {
  [[ $# -eq 6 ]] || usage

  local keychain_service="$1"
  local tunnel_client="$2"
  local profile="$3"
  local mcp_command="$4"
  local mcp_host="$5"
  local mcp_port="$6"
  local mcp_pid=""

  cleanup() {
    if [[ -n "$mcp_pid" ]] && kill -0 "$mcp_pid" >/dev/null 2>&1; then
      kill "$mcp_pid" >/dev/null 2>&1 || true
      wait "$mcp_pid" >/dev/null 2>&1 || true
    fi
  }

  wait_for_mcp() {
    local attempts=50
    local i

    for ((i = 0; i < attempts; i++)); do
      if (:</dev/tcp/"$mcp_host"/"$mcp_port") >/dev/null 2>&1; then
        return 0
      fi

      if ! kill -0 "$mcp_pid" >/dev/null 2>&1; then
        echo "tldw MCP server exited before $mcp_host:$mcp_port became reachable" >&2
        return 1
      fi

      sleep 0.2
    done

    echo "Timed out waiting for tldw MCP server on $mcp_host:$mcp_port" >&2
    return 1
  }

  if [[ -z "${CONTROL_PLANE_API_KEY:-}" ]]; then
    CONTROL_PLANE_API_KEY="$(
      /usr/bin/security find-generic-password \
        -a "$(keychain_account)" \
        -s "$keychain_service" \
        -w
    )"
    export CONTROL_PLANE_API_KEY
  fi

  trap 'cleanup' EXIT
  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM

  # Preserve launchd's PATH so Homebrew tools take precedence over older installs.
  MCP_HOST="$mcp_host" MCP_PORT="$mcp_port" /bin/bash -c "exec $mcp_command --host \"\$MCP_HOST\" --port \"\$MCP_PORT\"" &
  mcp_pid="$!"
  wait_for_mcp

  local status=0
  "$tunnel_client" run --profile "$profile" || status=$?
  cleanup
  trap - EXIT INT TERM
  return "$status"
}

# Allow the status formatter to be sourced by deterministic tests.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

case "${1:-}" in
  install)
    shift
    install_agent "$@"
    ;;
  uninstall)
    shift
    uninstall_agent "$@"
    ;;
  restart)
    shift
    restart_agent "$@"
    ;;
  status)
    shift
    status_agent "$@"
    ;;
  logs)
    shift
    case "${1:-}" in
      "")
        tail -n 80 "$HOME/Library/Logs/tldw/tunnel.err.log" "$HOME/Library/Logs/tldw/tunnel.out.log"
        ;;
      --tail)
        [[ $# -eq 1 ]] || usage
        tail -f "$HOME/Library/Logs/tldw/tunnel.err.log" "$HOME/Library/Logs/tldw/tunnel.out.log"
        ;;
      *)
        usage
        ;;
    esac
    ;;
  run)
    shift
    run_agent "$@"
    ;;
  *)
    usage
    ;;
esac
